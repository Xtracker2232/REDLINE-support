# Copy to .env (local) or paste into Railway > Variables

DISCORD_TOKEN=
GUILD_ID=

# Role given when someone accepts the rules (/reglement)
RULES_ROLE_ID=1571266194617667614

# Optional: your server's custom emojis for the board lines.
# In Discord type \:mtb_top: and send it to get the code like <:mtb_top:123456789012345678>
EMOJI_TOP=
EMOJI_MIDDLE=
EMOJI_BOTTOM=

# Optional: where the board is saved. On Railway, attach a Volume on /data and set DATA_DIR=/data
DATA_DIR=
